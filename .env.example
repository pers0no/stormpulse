# Copy to .env — `npm start` and `npm run dev` load it automatically.

PORT=3000
HOST=127.0.0.1

# NWS asks every client to identify itself, ideally with a way to contact you.
NWS_USER_AGENT="StormPulse/1.0 (your-site.example.com, you@example.com)"

# How often to check the alerts feed (minimum 30).
POLL_INTERVAL_SECONDS=120

DB_PATH=data/stormpulse.db
# How long to keep ended alerts and chart history.
HISTORY_HOURS=48

# ── Notifications ─────────────────────────────────────────
# Slack incoming webhook or Discord webhook URL. Leave empty for a dry run (matches are only logged).
WEBHOOK_URL=
# Extreme | Severe | Moderate | Minor | Unknown
NOTIFY_MIN_SEVERITY=Severe
# Comma-separated state codes to watch, e.g. TX,OK,KS. Empty = the whole country.
NOTIFY_AREAS=
NOTIFY_INCLUDE_MARINE=false
# Cap per poll (max 10); the rest are summarized as "…and N more".
NOTIFY_MAX_PER_POLL=5
# Public URL of this dashboard, used for links in notifications.
PUBLIC_URL=

# When set, POST /api/poll requires "Authorization: Bearer <token>".
ADMIN_TOKEN=

LOG_LEVEL=info
